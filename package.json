{
  "name": "whileai",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Send one prompt to every AI chat you are signed in to, and measure how long you wait for the answers.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "zip": "node scripts/build.mjs --zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "harness": "node test-harness/server.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "sync:selectors": "node scripts/sync-selectors.mjs",
    "e2e": "playwright test tests/e2e/broadcast.spec.ts",
    "e2e:health": "playwright test tests/e2e/health.spec.ts",
    "e2e:login": "node scripts/e2e-login.mjs",
    "health:live": "node scripts/live-health.mjs",
    "session": "node scripts/session.mjs",
    "live:check": "node scripts/live.mjs check",
    "live:send": "node scripts/live.mjs send",
    "logs": "node scripts/logs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.3.0",
    "esbuild": "^0.24.0",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^15.11.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
