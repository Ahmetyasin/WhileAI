{
  "name": "whileai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Measures how long you wait for AI chatbot responses, and how much of that wait you actually spend on the tab.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "zip": "node scripts/build.mjs --zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "harness": "node test-harness/server.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.3.0",
    "esbuild": "^0.24.0",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^15.11.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
